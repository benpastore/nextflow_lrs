# GPU inference image for HERRO_INFERENCE, built with Apptainer on OSC (no
# Docker needed). Apptainer .def has no multi-stage build, so this flattens
# Dockerfile.inference into one stage and deletes build artifacts afterward
# to keep the final image reasonably small.
#
# No GPU needed to build -- compiling against the CUDA toolkit doesn't
# require a physical GPU, only running herro does. RUSTFLAGS below targets
# a portable x86-64-v2 baseline rather than -Ctarget-cpu=native, since OSC
# has multiple GPU node types and there's no way to know which one a given
# job lands on -- native would risk an illegal-instruction crash on any
# node whose CPU doesn't match the build machine.
#
#   cd docker/herro
#   apptainer build --fakeroot --no-mount tmp herro-inference.sif herro-inference.def
#
# --no-mount tmp matters: Apptainer binds the host's /tmp into the build
# by default, and under --fakeroot its permissions/ownership often don't
# line up with the mapped-root user namespace, breaking apt-key's
# temp-file creation ("Couldn't create temporary file /tmp/apt.conf.XXXXXX"
# on every apt repo). Skipping that bind lets /tmp come from the base
# image itself instead, which has correct root:root 1777 permissions.
#
# Then point nextflow.config's herro_inference container at the resulting
# .sif path (see params.herro_inference_sif).

Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y wget git unzip curl build-essential zlib1g-dev zstd libgomp1
    rm -rf /var/lib/apt/lists/*

    # minimap2
    git clone https://github.com/lh3/minimap2.git /minimap2
    cd /minimap2 && make

    # rust toolchain
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    export PATH="/root/.cargo/bin:${PATH}"

    # libtorch
    wget -q -O /libtorch.zip "https://download.pytorch.org/libtorch/cu124/libtorch-cxx11-abi-shared-with-deps-2.4.0%2Bcu124.zip"
    cd / && unzip -q libtorch.zip && rm libtorch.zip

    # herro, built against libtorch/CUDA -- x86-64-v2 is a portable
    # baseline (safe on any CPU from roughly the last 15 years) since we
    # don't know which OSC GPU node type this will run on
    git clone https://github.com/lbcb-sci/herro.git /herro
    cd /herro
    export LIBTORCH=/libtorch
    export LD_LIBRARY_PATH=${LIBTORCH}/lib:${LD_LIBRARY_PATH}
    export PATH="/root/.cargo/bin:${PATH}"
    RUSTFLAGS="-Ctarget-cpu=x86-64-v2" cargo build -q --release

    # install to final locations
    cp /minimap2/minimap2 /bin/minimap2
    cp /herro/target/release/herro /bin/herro
    mkdir -p /libs
    cp -r /libtorch/* /libs/

    # R10.4.1 model weights, baked in like the Docker build does
    mkdir -p /opt
    wget -q -O /opt/model_R10_v0.1.pt "https://zenodo.org/records/12683277/files/model_v0.1.pt?download=1"

    # drop build tooling/sources to shrink the final image
    rm -rf /minimap2 /herro /libtorch /root/.cargo /root/.rustup
    apt-get purge -y wget git unzip curl build-essential
    apt-get autoremove -y
    rm -rf /var/lib/apt/lists/*

%environment
    export LIBTORCH=/libs
    export LD_LIBRARY_PATH=/libs/lib:${LD_LIBRARY_PATH}

%labels
    Author Dominik Stanojevic
    Version v0.1.1
    Name herro-inference
