# GPU inference image for HERRO_INFERENCE, built natively on OSC with
# Apptainer (no Docker needed). Apptainer .def has no multi-stage build, so
# this flattens Dockerfile.inference into one stage and deletes build
# artifacts afterward to keep the final image reasonably small.
#
# Build ON A GPU NODE (matters: RUSTFLAGS=-Ctarget-cpu=native below bakes in
# CPU-specific instructions -- build on hardware that matches, or is the
# same generation as, the nodes this will actually run on):
#
#   srun --account=PAS0631 --partition=nextgen --cluster=ascend \
#        --gpus-per-node=1 --mem=64gb --time=02:00:00 --pty bash
#   cd docker/herro
#   apptainer build --fakeroot herro-inference.sif herro-inference.def
#
# Then point nextflow.config's herro_inference container at the resulting
# .sif path (see params.herro_inference_sif).

Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y wget git unzip curl build-essential zlib1g-dev zstd libgomp1
    rm -rf /var/lib/apt/lists/*

    # minimap2
    git clone https://github.com/lh3/minimap2.git /minimap2
    cd /minimap2 && make

    # rust toolchain
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    export PATH="/root/.cargo/bin:${PATH}"

    # libtorch
    wget -q -O /libtorch.zip "https://download.pytorch.org/libtorch/cu124/libtorch-cxx11-abi-shared-with-deps-2.4.0%2Bcu124.zip"
    cd / && unzip -q libtorch.zip && rm libtorch.zip

    # herro, built against libtorch/CUDA -- native is safe here because
    # this .def is meant to be built on the same GPU node generation it
    # will run on (see build instructions above)
    git clone https://github.com/lbcb-sci/herro.git /herro
    cd /herro
    export LIBTORCH=/libtorch
    export LD_LIBRARY_PATH=${LIBTORCH}/lib:${LD_LIBRARY_PATH}
    export PATH="/root/.cargo/bin:${PATH}"
    RUSTFLAGS="-Ctarget-cpu=native" cargo build -q --release

    # install to final locations
    cp /minimap2/minimap2 /bin/minimap2
    cp /herro/target/release/herro /bin/herro
    mkdir -p /libs
    cp -r /libtorch/* /libs/

    # R10.4.1 model weights, baked in like the Docker build does
    mkdir -p /opt
    wget -q -O /opt/model_R10_v0.1.pt "https://zenodo.org/records/12683277/files/model_v0.1.pt?download=1"

    # drop build tooling/sources to shrink the final image
    rm -rf /minimap2 /herro /libtorch /root/.cargo /root/.rustup
    apt-get purge -y wget git unzip curl build-essential
    apt-get autoremove -y
    rm -rf /var/lib/apt/lists/*

%environment
    export LIBTORCH=/libs
    export LD_LIBRARY_PATH=/libs/lib:${LD_LIBRARY_PATH}

%labels
    Author Dominik Stanojevic
    Version v0.1.1
    Name herro-inference
