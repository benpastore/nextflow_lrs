manifest {
    description = "NANOPORE PROM sequencing analysis pipeline"
    author = "Ben Pastore pastore.28@osu.edu"
}

workDir = "/fs/scratch/PAS0631/AAA_DEBUG_HAPLO_AWARE"
singularity.cacheDir = "${baseDir}/singularity"

process.shell = ["/bin/bash", "-euo", "pipefail"] 
// Global default params, used in configs

params {
    help = false
    base = baseDir
    genome =  "/fs/ess/PCON0160/ben/genomes/T2T_CHM13v2.0/UCSC_ref/hs1.fa"
    publish_mode = "copy"
    include_illumina = false
    dorado_trim = true
    default_dorado_seq_kit = "SQK-LSK114"
    debug = true
    use_illumina = false
    dorado = true
    phasing_tool = "longphase"
    assemble_genome = true

    // Options : pod5 entry point. When set, the pipeline basecalls directly
    // from pod5 instead of starting from an already-basecalled design.csv
    // (path to a csv, header: sample,pod5 -- pod5 column is a directory of
    // pod5 files per sample). Leave false/"" to use --design as before.
    pod5_design = false
    // dorado basecaller model string (positional arg, not a path) -- the
    // "5mCG_5hmCG" mod-calling tag embeds MM/ML methylation tags per read,
    // which is what any downstream methylation analysis (e.g. modkit) reads.
    dorado_basecall_model = "sup,5mCG_5hmCG"

    // Options : methylation (raw-read alignment + modkit pileup, see main.nf).
    // Set false if the input bam/fastq was basecalled without mod-calling
    // enabled (no MM/ML tags) -- otherwise this spends compute producing
    // empty output.
    run_methylation = false

    // Options : paraphase (SMA/SMN1-SMN2 region reconstruction)
    paraphase_genome_build = "chm13"
    paraphase_genes = ""
    paraphase_args = ""

    // Options : post-hoc haplotype annotation for straglr/spectre (see
    // bin/annotate_haplotype.py) -- neither has a native phasing mode, so
    // each call gets tagged from HP:i:1/HP:i:2 reads within +/- this many bp
    // of the call's start/end, rather than re-calling on split BAMs.
    haplotype_flank_bp = 1000

    // Options : HERRO (https://github.com/lbcb-sci/herro) GPU deep-learning ONT
    // self-correction -- runs on every sample, no per-sample gating (herro has no
    // notion of matched Illumina data, unlike the old hybrid "HERO" tool this replaced).
    // R10.4.1 model weights -- lbcb-sci/herro doesn't bake these into their
    // image, so download once and point this at the file:
    //   wget -O /fs/ess/PAS0631/BEN_PIPELINE/nextflow_lrs/models/herro/model_R10_v0.1.pt \
    //     "https://zenodo.org/records/12683277/files/model_v0.1.pt?download=1"
    herro_model = "/fs/ess/PAS0631/BEN_PIPELINE/nextflow_lrs/models/herro/model_R10_v0.1.pt"
    herro_gpu_ids = "0"
    herro_batch_size = 64
    herro_preprocess_parts = 4
    // lbcb-sci/herro publish a prebuilt Singularity image directly on
    // Zenodo -- no Docker/Apptainer build needed at all. Download once:
    //   wget -O /fs/ess/PAS0631/BEN_PIPELINE/nextflow_lrs/containers/herro.sif \
    //     "https://zenodo.org/records/13802680/files/herro.sif?download=1"
    herro_inference_sif = "/fs/ess/PAS0631/BEN_PIPELINE/nextflow_lrs/containers/herro.sif"

    // Options : trio / haplotype family structure (assembly trio-binning +
    // pedigree-aware phasing). Path to a JSON mapping each child sampleID to
    // its parents' sampleIDs: {"child": {"father": "...", "mother": "..."}}.
    // Parents need no Illumina data -- they must just be ordinary rows in
    // the same ONT design.csv/pod5_design as children (their yak db and
    // genotype VCF are both built from their own ONT reads); family_json is
    // what identifies which sampleIDs are parents and routes them out of
    // the full assembly/alignment/phasing pipeline.
    family_json = false
    // Master on/off switch for trio-specific behavior. Leave false for
    // singular-genome runs -- flip to true (with family_json set) only when
    // actually analyzing trios, rather than removing/re-adding family_json
    // each time you switch modes.
    run_trio_analysis = false

    // Options : snpEff variant-effect annotation, run on consolidate_variants'
    // per-sample master VCF. No stock snpEff database covers T2T-CHM13 (the
    // default params.genome above), so snpeff_db is built on the fly from
    // params.genome + snpeff_gtf (a GTF matching the genome's coordinates,
    // e.g. UCSC's hs1 CAT+Liftoff gene set, or NCBI RefSeq GCF_009914755.1)
    // the first time the pipeline is run, then published to snpeff_data_dir
    // and reused (skipping the rebuild) on every run after that. snpeff_gtf
    // is only required until snpeff_data_dir/snpeff_db/snpEffectPredictor.bin
    // exists -- if you already have a prebuilt snpEff database, just point
    // snpeff_db/snpeff_data_dir at it and leave snpeff_gtf unset.
    run_snpeff = true
    snpeff_db = "T2T_CHM13v2"
    snpeff_data_dir = "/fs/ess/PAS0631/BEN_PIPELINE/nextflow_lrs/snpeff_data"
    snpeff_gtf = "/fs/ess/PCON0160/ben/genomes/T2T_CHM13v2.0/UCSC_ref/hs1.ncbiRefSeq.gtf"
    snpeff_args = ""
    // csvStats/htmlStats build cohort-wide summary plots -- often the
    // single biggest chunk of snpEff's runtime on a large VCF, and nothing
    // downstream in this pipeline consumes them (annotation-only use).
    // Off by default for speed; set true to get them back for manual review.
    snpeff_stats = false
    // JVM heap size for snpEff -- the default heap is far too small to read a
    // ~3Gb genome FASTA (readExonSequences buffers each sequence as a
    // StringBuffer), causing java.lang.OutOfMemoryError during build. Keep
    // this comfortably under the "snpeff" label's --mem in the slurm config below.
    snpeff_java_mem = "28g"
    // Per-worker heap for the parallel chromosome-scatter annotation path
    // (used when snpeff_stats=false) -- kept modest since each of the
    // "snpeff" label's task.cpus workers reloads the full genome model
    // concurrently; scale with snpeff_scatter_java_mem * cpus in mind when
    // sizing the "snpeff" label's --mem below.
    snpeff_scatter_java_mem = "4g"

    // Options : recessive-modifier candidate search (bin/recessive_modifier_consolidated.py)
    // over the consolidated+snpEff VCF. Runs only when run_snpeff and
    // family_json are both set (mirrors the run_trio gate above) --
    // family.json's "phenotype": "mild"/"severe" field drives the
    // mild-vs-severe groupings (a field run_trio's own family.json use
    // doesn't touch).
    recessive_modifier_sv_merge_dist = 500
    // Optional: gnomAD VCF already lifted onto CHM13 coordinates, for
    // AF_nfe annotation of the final pass -- see bin/recessive_modifier_ont.py's
    // -gnomad_chm13_vcf help text for where to get one. Leave unset to skip.
    gnomad_chm13_vcf = ""

    // Options : AlphaGenome variant-effect annotation
    // Scaffold only -- see bin/run_alphagenome.py TODOs before enabling.
    run_alphagenome = false
    alphagenome_weights = ""
    alphagenome_args = ""

    ////////// illumina hyperparams ////////////
    // Options : fastqc 
    trim_adapters = true
    fastqc = false

    // Options : bwa index
    bwa_index_alg = "is"

    // Options: Alignments
    aligner = "bwa"
    bwa_min_score = false
    keep_dups = false
    keep_multi_map = false
    select_primary = false
    remove_orphan = true
    blacklist = false
    filter_bam = true
    
    // Options : DeepTools
    normalize_bw = "CPM"
    smooth_length = 10
    exact_scaling = true
    filter_strand = false
    bin_size = 5
    bw_compare_operation = "ratio"
    bw_compare_pseudocount = 1
    merge_bw = true

}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${baseDir}/singularity" 
    containerOptions = "--nv"
}
singularity.pullTimeout = "2h"

/*
apptainer { 
    enabled = true
    automounts = true
    cacheDir = "${baseDir}/apptainer"
    containerOptions = "--nv"
}
apptainer.pullTimeout = "2h"
*/

process {

    hpc_account = "PAS0631"
    
    additional_cluster_commands="--cluster=ascend --partition=nextgen "

    withLabel:"nanoplot" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=01:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://staphb/nanoplot:latest"
    }

    withLabel:"longqc" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=01:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://cymbopogon/longqc:latest"
    }


    // general labels all use my docker container
    withLabel:"low" {
        executor = "slurm"
        cpus = 15
        clusterOptions = "--account=$hpc_account --time=01:00:00 --nodes=1 --mem=32gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/rnaseq:latest"
    }

    withLabel: "recessive_modifier" {
        // parses full WGS consolidated+snpEff VCFs for every mild/severe
        // sample into memory at once (bin/recessive_modifier_consolidated.py's
        // run() caches every parsed sample for the whole cohort comparison,
        // never evicting) -- this OOM'd at 32gb (the "low" label) on a real
        // cohort run, so give it real headroom. Single Python process, not
        // parallelized, so cpus stay modest.
        executor = "slurm"
        cpus = 4
        clusterOptions = "--account=$hpc_account --time=02:00:00 --nodes=1 --mem=128gb $additional_cluster_commands "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/rnaseq:latest"
    }

    withLabel:"medium" {
        executor = "slurm"
        cpus = 20
        clusterOptions = "--account=$hpc_account --time=02:00:00 --nodes=1 --mem=64gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/rnaseq:latest"
    }

    withLabel:"high" {
        executor = "slurm"
        cpus = 30
        clusterOptions = "--account=$hpc_account --time=36:00:00 --nodes=1 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/rnaseq:latest"
    }
    
    withLabel:"extra_high" {
        executor = "slurm"
        cpus = 30
        clusterOptions = "--account=$hpc_account --time=100:00:00 --nodes=1 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/rnaseq:latest"
    }

    // software specific containers
    withLabel:"atria" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=64gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/atria:latest"
    }

    withLabel:"DeepVariant" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --nodes=1 --mem=128gb --gpus-per-node=2 --gpu_cmode=shared "
        singularity.enabled = true
        singularity.autoMounts = true
        cpus = 20
        time = "24h"
        container = "docker://google/deepvariant:latest"
        containerOptions = "--nv"
    }

    withLabel:"hifasim" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=24:00:00 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/hifiasm:latest"
        cpus = 25
    }

    withLabel:"gfatools" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=02:00:00 --mem=64gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://quay.io/biocontainers/gfatools:0.5.5--h577a1d6_0"
        cpus = 25
    }

    withLabel: "samtools" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=1:00:00 --mem=64gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "quay.io/biocontainers/samtools:1.22--h96c455f_0"
        cpus = 25
    }

    withLabel: "samtools_high" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "quay.io/biocontainers/samtools:1.22--h96c455f_0"
        cpus = 25
    }

    withLabel: "porechop" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=6:00:00 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://biocontainers/porechop:v0.2.4dfsg-1-deb_cv1"
        cpus = 25
    }
 
    withLabel:"hapdup" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=64gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://mkolmogo/hapdup:torch110"
    }

    withLabel:"dipcall" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=24:00:00 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://quay.io/biocontainers/dipcall:0.3--hdfd78af_0"
        cpus = 25
    }

    withLabel:"hapdiff" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=24:00:00 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://mkolmogo/hapdiff:0.9"
        cpus = 25

    }

    withLabel: "clair3" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=24:00:00 --mem=128gb --gpus-per-node=1 $additional_cluster_commands "
        container = "docker://hkubal/clair3:v2.0.1_gpu"
        containerOptions = "--nv"
        cpus = 25
    }

    withLabel:"minimap2" {
        executor = "slurm"
        cpus = 30
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://benpasto/minimap2:latest"
    }

    withLabel: "whatshap" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://jlalli/whatshap:2.1"
    }

    withLabel: "longphase" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://benpasto/longphase:latest"
    }

    withLabel: "sniffles" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        // pinned (not :latest) -- --phase (see modules/sniffles/main.nf) needs
        // Sniffles2 >=2.2; 2.3.2 is a known-good, verified-to-exist tag.
        container = "docker://quay.io/biocontainers/sniffles:2.3.2--pyhdfd78af_1"
    }

    withLabel: "bcftools" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=06:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://quay.io/biocontainers/bcftools:1.22--h3a4d415_1"
    }

    withLabel: "spectre" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://benpasto/spectre:latest"
    }

    withLabel: "straglr" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://quay.io/biocontainers/straglr:1.5.6--pyhdfd78af_1"
    }

    withLabel: "paraphase" {
        executor = "slurm"
        cpus = 8
        clusterOptions = "--account=$hpc_account --time=06:00:00 --mem=64gb $additional_cluster_commands "
        // Pinned to the pre-Rust-rewrite Python release, not the current
        // 4.0.0. 4.0.0's Rust-internal minimap2/htslib realignment step
        // panics on every read (NUL bytes corrupting SAM text at fixed
        // field boundaries -- QNAME, RNAME, RNEXT -- regardless of read
        // content) for both genes CHM13 supports (smn1, pms2), which
        // paraphase silently catches and reports as "Completed" with
        // near-empty output. pms2-on-chm13 was added in the same 4.0.0
        // release that introduced the broken Rust realignment code, so
        // downgrading loses nothing there; smn1-on-chm13 has been stable
        // since the old Python v3.3.0 (2025-04-26), well before the
        // rewrite. Built from docker/paraphase/Dockerfile: the stock
        // biocontainers 3.5.0 image lacks samtools/minimap2 (not declared
        // bioconda deps, but paraphase 3.5.0 shells out to both) --
        // confirmed via `which samtools minimap2 paraphase` on OSC, only
        // paraphase resolved. This image bundles all three via mamba.
        container = "docker://benpasto/paraphase:3.5.0"
    }

    withLabel: "modkit" {
        executor = "slurm"
        cpus = 16
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=64gb $additional_cluster_commands "
        container = "docker://quay.io/biocontainers/ont-modkit:0.6.4--h7f49ad2_0"
    }

    withLabel: "yak" {
        executor = "slurm"
        cpus = 16
        clusterOptions = "--account=$hpc_account --time=06:00:00 --mem=64gb $additional_cluster_commands "
        container = "docker://quay.io/biocontainers/yak:0.1--h577a1d6_6"
    }

    withLabel: "herro_preprocess" {
        // built from docker/herro/Dockerfile (clone of lbcb-sci/herro +
        // its exact conda env from scripts/herro-env.yml -- seqkit,
        // minimap2, duplex-tools, a patched porechop fork). CPU only --
        // this stage does adapter trimming/splitting/length filtering,
        // no GPU/libtorch involved. Build and push yourself:
        //   docker build -t benpasto/herro:latest -f docker/herro/Dockerfile docker/herro/
        //   docker push benpasto/herro:latest
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/herro:latest"
    }

    withLabel: "herro_align" {
        // same image as herro_preprocess (seqkit + minimap2 all-vs-all read
        // self-alignment) -- CPU only, batches read alignments for the GPU
        // inference step below.
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/herro:latest"
    }

    withLabel: "herro_inference" {
        // lbcb-sci/herro's own prebuilt image (Rust + libtorch 2.4 + CUDA
        // 12.4 runtime + minimap2 + the herro binary), downloaded directly
        // from Zenodo -- no build needed. See params.herro_inference_sif
        // and params.herro_model for the download commands.
        executor = "slurm"
        cpus = 8
        clusterOptions = "--account=$hpc_account --time=24:00:00 --mem=128gb --gpus-per-node=1 $additional_cluster_commands "
        singularity.enabled = true
        singularity.autoMounts = true
        containerOptions = "--nv"
        container = params.herro_inference_sif
    }

    withLabel: "dorado" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands --gpus-per-node=1 "
        container = "docker://nanoporetech/dorado:latest"
        containerOptions = "--nv"
    }

    withLabel: "snpeff" {
        // snpEff itself has no working multi-threading flag, so cpus here
        // are used by the SNPEFF module's own chromosome-scatter path
        // (modules/snpeff/main.nf) instead: task.cpus concurrent snpEff
        // workers, each loading the full genome model independently, so
        // --mem needs to cover ~cpus * snpeff_scatter_java_mem plus JVM
        // overhead per worker (8 * 4g heap here, with headroom).
        executor = "slurm"
        cpus = 8
        clusterOptions = "--account=$hpc_account --time=04:00:00 --mem=64gb $additional_cluster_commands "
        container = "docker://quay.io/biocontainers/snpeff:5.2--hdfd78af_1"
    }

    withLabel: "alphagenome" {
        // TODO: point this at a container/conda env that has the alphagenome
        // package (or whatever local-inference code you use against the
        // weights directory) installed. Left unset on purpose so runs fail
        // loudly instead of silently using the wrong environment.
        executor = "slurm"
        cpus = 8
        clusterOptions = "--account=$hpc_account --time=04:00:00 --mem=64gb $additional_cluster_commands --gpus-per-node=1 "
        containerOptions = "--nv"
    }

}