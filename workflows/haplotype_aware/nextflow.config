manifest {
    description = "NANOPORE PROM sequencing analysis pipeline"
    author = "Ben Pastore pastore.28@osu.edu"
}

workDir = "/fs/scratch/PAS0631/AAA_DEBUG_HAPLO_AWARE"
singularity.cacheDir = "${baseDir}/singularity"

process.shell = ["/bin/bash", "-euo", "pipefail"] 
// Global default params, used in configs

params {
    help = false
    base = baseDir
    genome =  "/fs/ess/PCON0160/ben/genomes/T2T_CHM13v2.0/UCSC_ref/hs1.fa"
    publish_mode = "copy"
    include_illumina = false
    dorado_trim = true
    default_dorado_seq_kit = "SQK-LSK114"
    debug = true
    use_illumina = false
    dorado = true
    phasing_tool = "longphase"
    assemble_genome = true

    // Options : pod5 entry point. When set, the pipeline basecalls directly
    // from pod5 instead of starting from an already-basecalled design.csv
    // (path to a csv, header: sample,pod5 -- pod5 column is a directory of
    // pod5 files per sample). Leave false/"" to use --design as before.
    pod5_design = false
    // dorado basecaller model string (positional arg, not a path) -- the
    // "5mCG_5hmCG" mod-calling tag embeds MM/ML methylation tags per read,
    // which is what any downstream methylation analysis (e.g. modkit) reads.
    dorado_basecall_model = "sup,5mCG_5hmCG"

    // Options : paraphase (SMA/SMN1-SMN2 region reconstruction)
    paraphase_genome_build = "chm13"
    paraphase_genes = ""
    paraphase_args = ""

    // Options : HERO hybrid (Illumina + ONT) long-read error correction
    // Path to a csv (header: sample,r1,r2) mapping sampleIDs to Illumina paired-end
    // fastqs. Only samples present here get corrected; others pass through unchanged.
    // Set to false/"" to disable HERO correction entirely.
    illumina_design = false
    hero_chunk_size = 30
    // HERO has no bioconda/pip package -- point this at wherever HERO.py lives inside
    // the container built for the "hero" process label (see modules/hero/main.nf).
    hero_bin = "/opt/HERO/bin"

    // Options : trio / haplotype family structure (assembly trio-binning +
    // pedigree-aware phasing). Path to a JSON mapping each child sampleID to
    // its parents' sampleIDs: {"child": {"father": "...", "mother": "..."}}.
    // Parents need no Illumina data -- they must just be ordinary rows in
    // the same ONT design.csv/pod5_design as children (their yak db and
    // genotype VCF are both built from their own ONT reads); family_json is
    // what identifies which sampleIDs are parents and routes them out of
    // the full assembly/alignment/phasing pipeline.
    family_json = false
    // Master on/off switch for trio-specific behavior. Leave false for
    // singular-genome runs -- flip to true (with family_json set) only when
    // actually analyzing trios, rather than removing/re-adding family_json
    // each time you switch modes.
    run_trio_analysis = false

    // Options : AlphaGenome variant-effect annotation
    // Scaffold only -- see bin/run_alphagenome.py TODOs before enabling.
    run_alphagenome = false
    alphagenome_weights = ""
    alphagenome_args = ""

    ////////// illumina hyperparams ////////////
    // Options : fastqc 
    trim_adapters = true
    fastqc = false

    // Options : bwa index
    bwa_index_alg = "is"

    // Options: Alignments
    aligner = "bwa"
    bwa_min_score = false
    keep_dups = false
    keep_multi_map = false
    select_primary = false
    remove_orphan = true
    blacklist = false
    filter_bam = true
    
    // Options : DeepTools
    normalize_bw = "CPM"
    smooth_length = 10
    exact_scaling = true
    filter_strand = false
    bin_size = 5
    bw_compare_operation = "ratio"
    bw_compare_pseudocount = 1
    merge_bw = true

}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${baseDir}/singularity" 
    containerOptions = "--nv"
}
singularity.pullTimeout = "2h"

/*
apptainer { 
    enabled = true
    automounts = true
    cacheDir = "${baseDir}/apptainer"
    containerOptions = "--nv"
}
apptainer.pullTimeout = "2h"
*/

process {

    hpc_account = "PAS0631"
    
    additional_cluster_commands="--cluster=ascend --partition=nextgen "

    withLabel:"nanoplot" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=01:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://staphb/nanoplot:latest"
    }

    withLabel:"longqc" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=01:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://cymbopogon/longqc:latest"
    }


    // general labels all use my docker container
    withLabel:"low" {
        executor = "slurm"
        cpus = 15
        clusterOptions = "--account=$hpc_account --time=01:00:00 --nodes=1 --mem=32gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/rnaseq:latest"
    }

    withLabel:"medium" {
        executor = "slurm"
        cpus = 20
        clusterOptions = "--account=$hpc_account --time=02:00:00 --nodes=1 --mem=64gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/rnaseq:latest"
    }

    withLabel:"high" {
        executor = "slurm"
        cpus = 30
        clusterOptions = "--account=$hpc_account --time=36:00:00 --nodes=1 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/rnaseq:latest"
    }
    
    withLabel:"extra_high" {
        executor = "slurm"
        cpus = 30
        clusterOptions = "--account=$hpc_account --time=100:00:00 --nodes=1 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/rnaseq:latest"
    }

    // software specific containers
    withLabel:"atria" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=64gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/atria:latest"
    }

    withLabel:"DeepVariant" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --nodes=1 --mem=128gb --gpus-per-node=2 --gpu_cmode=shared "
        singularity.enabled = true
        singularity.autoMounts = true
        cpus = 20
        time = "24h"
        container = "docker://google/deepvariant:latest"
        containerOptions = "--nv"
    }

    withLabel:"hifasim" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=24:00:00 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/hifiasm:latest"
        cpus = 25
    }

    withLabel:"gfatools" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=02:00:00 --mem=64gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://quay.io/biocontainers/gfatools:0.5.5--h577a1d6_0"
        cpus = 25
    }

    withLabel: "samtools" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=1:00:00 --mem=64gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "quay.io/biocontainers/samtools:1.22--h96c455f_0"
        cpus = 25
    }

    withLabel: "samtools_high" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "quay.io/biocontainers/samtools:1.22--h96c455f_0"
        cpus = 25
    }

    withLabel: "porechop" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=6:00:00 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://biocontainers/porechop:v0.2.4dfsg-1-deb_cv1"
        cpus = 25
    }
 
    withLabel:"hapdup" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=64gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://mkolmogo/hapdup:torch110"
    }

    withLabel:"dipcall" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=24:00:00 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://quay.io/biocontainers/dipcall:0.3--hdfd78af_0"
        cpus = 25
    }

    withLabel:"hapdiff" {
        executor = "slurm"
        clusterOptions = "--account=$hpc_account --time=24:00:00 --mem=128gb "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://mkolmogo/hapdiff:0.9"
        cpus = 25

    }

    withLabel: "clair3" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=24:00:00 --mem=128gb --gpus-per-node=1 $additional_cluster_commands "
        container = "docker://hkubal/clair3:v2.0.1_gpu"
        containerOptions = "--nv"
        cpus = 25
    }

    withLabel:"minimap2" {
        executor = "slurm"
        cpus = 30
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://benpasto/minimap2:latest"
    }

    withLabel: "whatshap" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://jlalli/whatshap:2.1"
    }

    withLabel: "longphase" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://benpasto/longphase:latest"
    }

    withLabel: "sniffles" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://benpasto/sniffles:latest"
    }

    withLabel: "bcftools" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=06:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://quay.io/biocontainers/bcftools:1.22--h3a4d415_1"
    }

    withLabel: "spectre" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://benpasto/spectre:latest"
    }

    withLabel: "straglr" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        container = "docker://quay.io/biocontainers/straglr:1.5.6--pyhdfd78af_1"
    }

    withLabel: "paraphase" {
        executor = "slurm"
        cpus = 8
        clusterOptions = "--account=$hpc_account --time=06:00:00 --mem=64gb $additional_cluster_commands "
        container = "docker://quay.io/biocontainers/paraphase:4.0.0--h9ee0642_0"
    }

    withLabel: "modkit" {
        executor = "slurm"
        cpus = 16
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=64gb $additional_cluster_commands "
        container = "docker://quay.io/biocontainers/ont-modkit:0.6.4--h7f49ad2_0"
    }

    withLabel: "ropebwt2" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=06:00:00 --mem=256gb $additional_cluster_commands "
        container = "docker://quay.io/biocontainers/ropebwt2:r187--h577a1d6_11"
    }

    withLabel: "sort_reads" {
        // zcat/awk/sort/tr prep step for ROPEBWT2, split out onto a
        // general-purpose container with real GNU coreutils -- the
        // ropebwt2 biocontainer above only ships BusyBox, whose `sort`
        // has no memory cap/spill-to-disk and segfaults on WGS-scale
        // read counts regardless of --mem.
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=06:00:00 --mem=256gb $additional_cluster_commands "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/rnaseq:latest"
    }

    withLabel: "fmlrc2" {
        // fmlrc2's memory footprint scales directly with BWT size (rank/
        // occurrence bit-vectors built on top of it) -- at full human WGS
        // scale (this run's BWT: 18.45B compressed values) that's a hard
        // cost, not something a flag can shrink. 64gb OOM-killed it outright.
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=256gb $additional_cluster_commands "
        container = "docker://quay.io/biocontainers/fmlrc2:0.1.8--h7f95895_0"
    }

    withLabel: "yak" {
        executor = "slurm"
        cpus = 16
        clusterOptions = "--account=$hpc_account --time=06:00:00 --mem=64gb $additional_cluster_commands "
        container = "docker://quay.io/biocontainers/yak:0.1--h577a1d6_6"
    }

    withLabel: "hero" {
        // built from docker/hero/Dockerfile (conda env with HERO's
        // dependencies per its upstream README + a clone of the repo at
        // /opt/HERO, matching params.hero_bin's default) -- build and push
        // this yourself, it isn't published anywhere:
        //   docker build -t benpasto/hero:latest -f docker/hero/Dockerfile docker/hero/
        //   docker push benpasto/hero:latest
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands "
        singularity.enabled = true
        singularity.autoMounts = true
        container = "docker://benpasto/hero:latest"
    }

    withLabel: "dorado" {
        executor = "slurm"
        cpus = 25
        clusterOptions = "--account=$hpc_account --time=12:00:00 --mem=128gb $additional_cluster_commands --gpus-per-node=1 "
        container = "docker://nanoporetech/dorado:latest"
        containerOptions = "--nv"
    }

    withLabel: "alphagenome" {
        // TODO: point this at a container/conda env that has the alphagenome
        // package (or whatever local-inference code you use against the
        // weights directory) installed. Left unset on purpose so runs fail
        // loudly instead of silently using the wrong environment.
        executor = "slurm"
        cpus = 8
        clusterOptions = "--account=$hpc_account --time=04:00:00 --mem=64gb $additional_cluster_commands --gpus-per-node=1 "
        containerOptions = "--nv"
    }

}